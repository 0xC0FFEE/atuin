_binname=atuin
pkgbase=atuin-git
pkgname=atuin-git
pkgver=20260609.r1705.ge490d23
pkgrel=1
pkgdesc='Blazingly fast shell history'
arch=('x86_64')
url="https://github.com/0xC0FFEE/$_binname"
license=(MIT)
depends=(gcc-libs
         glibc)
makedepends=(cargo git)
provides=("$_binname")
conflicts=("$_binname")
options=(!lto)
source=("$_binname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/$_binname"
	local date rev hash
	date=$(git log -1 --format=%cd --date=format:%Y%m%d)
	rev=$(git rev-list --count HEAD)
	hash=$(git rev-parse --short HEAD)
	printf '%s.r%s.g%s\n' "$date" "$rev" "$hash"
}

_srcenv () {
	cd "$srcdir/$_binname"

	# Use debug
	export CARGO_PROFILE_RELEASE_DEBUG=2 CARGO_PROFILE_RELEASE_STRIP=false

	# Use LTO
	export CARGO_PROFILE_RELEASE_LTO=true CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
}

prepare() {
	_srcenv

	cargo fetch --locked --target host-tuple
	mkdir -p completions/
}

build() {
	_srcenv
	cargo build --release --frozen --all-features
	for sh in 'bash' 'fish' 'zsh'; do
		"target/release/$_binname" gen-completions -s "$sh" -o completions/
	done
}

check() {
	_srcenv
	cargo test --frozen --all-features --workspace --lib
}

package_atuin-git() {
	cd "$srcdir/$_binname"
	optdepends=('bash-preexec: bash integration')
	install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$_binname"
	install -Dm0644 "completions/$_binname.bash" "$pkgdir/usr/share/bash-completion/completions/$_binname"
	install -Dm0644 -t "$pkgdir/usr/share/fish/vendor_completions.d/" "completions/$_binname.fish"
	install -Dm0644 -t "$pkgdir/usr/share/zsh/site-functions/" "completions/_$_binname"
	install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
